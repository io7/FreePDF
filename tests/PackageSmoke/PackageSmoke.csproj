<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net462;net472</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <FreePDFPackageVersion Condition="'$(FreePDFPackageVersion)' == ''">7.0.0-rc.1</FreePDFPackageVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="io7.FreePDF.MigraDoc" Version="$(FreePDFPackageVersion)" />
    <EmbeddedResource Include="../../lab/Assets/DejaVuSans.ttf" LogicalName="PackageFont.ttf" />
    <None Include="../../lab/Assets/DejaVuSans.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
