<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>io7.FreePDF.Wpf</PackageId>
    <TargetFrameworks>$(PDFsharpTargetFrameworks_Windows)</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Declares the WPF framework reference in the package, as PDFsharp-WPF does. -->
    <UseWPF>true</UseWPF>
    <Description>MIT PDF creation and editing for Windows desktop and .NET Framework apps, drawing through WPF (System.Windows.Media). The FreePDF build for apps moving from PDFsharp-WPF 6.2.4; preserves PdfSharp API namespaces. Use it instead of io7.FreePDF, not together with it.</Description>
    <FreePDFAssemblyPrefix>PdfSharp</FreePDFAssemblyPrefix>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../foundation/src/PDFsharp/src/PdfSharp-wpf/PdfSharp-wpf.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../foundation/src/PDFsharp/src/PdfSharp.BarCodes-wpf/PdfSharp.BarCodes-wpf.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../foundation/src/PDFsharp/src/PdfSharp.Charting-wpf/PdfSharp.Charting-wpf.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../foundation/src/PDFsharp/src/PdfSharp.Cryptography/PdfSharp.Cryptography.csproj" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
</Project>
