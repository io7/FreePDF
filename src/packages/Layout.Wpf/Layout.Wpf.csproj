<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>io7.FreePDF.Layout.Wpf</PackageId>
    <TargetFrameworks>$(PDFsharpTargetFrameworks_Windows)</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Description>MIT document layout with paragraphs, tables, charts and PDF/RTF output for io7.FreePDF.Wpf. The FreePDF build for apps moving from PDFsharp-MigraDoc-WPF 6.2.4; preserves MigraDoc API namespaces. Use it instead of io7.FreePDF.Layout, not together with it.</Description>
    <FreePDFAssemblyPrefix>MigraDoc</FreePDFAssemblyPrefix>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FreePDF.Wpf/FreePDF.Wpf.csproj" />
    <ProjectReference Include="../../foundation/src/MigraDoc/src/MigraDoc.DocumentObjectModel/MigraDoc.DocumentObjectModel.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../foundation/src/MigraDoc/src/MigraDoc.Rendering-wpf/MigraDoc.Rendering-wpf.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../foundation/src/MigraDoc/src/MigraDoc.RtfRendering-wpf/MigraDoc.RtfRendering-wpf.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
