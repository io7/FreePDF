<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>io7.FreePDF.Layout</PackageId>
    <Description>Drop-in replacement for PDFsharp-MigraDoc 6.2.4 under the MIT licence: document layout with paragraphs, tables, charts and PDF/RTF output for FreePDF. Keeps the MigraDoc namespaces, so most apps switch by changing the package reference.</Description>
    <FreePDFAssemblyPrefix>MigraDoc</FreePDFAssemblyPrefix>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FreePDF/FreePDF.csproj" />
    <ProjectReference Include="../../foundation/src/MigraDoc/src/MigraDoc.DocumentObjectModel/MigraDoc.DocumentObjectModel.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../foundation/src/MigraDoc/src/MigraDoc.Rendering/MigraDoc.Rendering.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../foundation/src/MigraDoc/src/MigraDoc.RtfRendering/MigraDoc.RtfRendering.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
