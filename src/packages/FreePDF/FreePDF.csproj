<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>io7.FreePDF</PackageId>
    <Description>Drop-in replacement for PDFsharp 6.2.4 under the MIT licence: PDF creation, reading and editing for .NET, continued from the last MIT PDFsharp source. Includes drawing, form filling and flattening, barcodes, charts and cryptography. Keeps the PdfSharp namespaces, so most apps switch by changing the package reference.</Description>
    <FreePDFAssemblyPrefix>PdfSharp</FreePDFAssemblyPrefix>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../foundation/src/PDFsharp/src/PdfSharp/PdfSharp.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../foundation/src/PDFsharp/src/PdfSharp.BarCodes/PdfSharp.BarCodes.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../foundation/src/PDFsharp/src/PdfSharp.Charting/PdfSharp.Charting.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../foundation/src/PDFsharp/src/PdfSharp.Cryptography/PdfSharp.Cryptography.csproj" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
</Project>
