<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>io7.FreePDF.Gdi</PackageId>
    <TargetFrameworks>$(PDFsharpTargetFrameworks_Windows)</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Declares the Windows Forms framework reference in the package, as PDFsharp-GDI does, so System.Drawing resolves. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Description>MIT PDF creation and editing for Windows desktop and .NET Framework apps, drawing through GDI+ (System.Drawing). The FreePDF build for apps moving from PDFsharp-GDI 6.2.4; preserves PdfSharp API namespaces. Use it instead of io7.FreePDF, not together with it.</Description>
    <FreePDFAssemblyPrefix>PdfSharp</FreePDFAssemblyPrefix>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../foundation/src/PDFsharp/src/PdfSharp-gdi/PdfSharp-gdi.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../foundation/src/PDFsharp/src/PdfSharp.BarCodes-gdi/PdfSharp.BarCodes-gdi.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../foundation/src/PDFsharp/src/PdfSharp.Charting-gdi/PdfSharp.Charting-gdi.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../foundation/src/PDFsharp/src/PdfSharp.Cryptography/PdfSharp.Cryptography.csproj" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
</Project>
