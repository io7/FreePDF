<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;netstandard2.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- NuGet shows authors as the publisher; empira's authorship stays in Copyright and LICENSE. -->
    <Authors>io7</Authors>
    <Copyright>Copyright 2001-2026 empira Software GmbH; FreePDF modifications copyright 2026 io7</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/io7/FreePDF</PackageProjectUrl>
    <RepositoryUrl>https://github.com/io7/FreePDF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>FreePDF;PDF;MigraDoc;MIT</PackageTags>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);FreePDFPackageFiles</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../PROVENANCE.md" Pack="true" PackagePath="PROVENANCE.md" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="README.md" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)ICC-sRGB2014.txt" Pack="true" PackagePath="THIRD-PARTY/ICC-sRGB2014.txt" />
    <None Include="$(MSBuildThisFileDirectory)../foundation/src/shared/src/PdfSharp.Imaging/Png/BigGustave/LICENSE" Pack="true" PackagePath="THIRD-PARTY/BigGustave/" />
  </ItemGroup>
  <Target Name="FreePDFPackageFiles">
    <PropertyGroup>
      <!-- NuGet requires a platform version in Windows lib folders: net8.0-windows becomes net8.0-windows7.0. -->
      <FreePDFLibFolder>$(TargetFramework)</FreePDFLibFolder>
      <FreePDFLibFolder Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' and '$(TargetPlatformIdentifier)' == 'Windows' and !$(TargetFramework.EndsWith('$(TargetPlatformVersion)'))">$(TargetFramework)$(TargetPlatformVersion)</FreePDFLibFolder>
    </PropertyGroup>
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)$(FreePDFAssemblyPrefix)*.dll;$(OutputPath)$(FreePDFAssemblyPrefix)*.xml" Exclude="$(OutputPath)$(AssemblyName).dll;$(OutputPath)$(AssemblyName).xml" PackagePath="lib/$(FreePDFLibFolder)/" />
    </ItemGroup>
  </Target>
</Project>
