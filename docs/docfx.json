{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/foundation/src",
          "files": [
            "PDFsharp/src/PdfSharp/PdfSharp.csproj",
            "PDFsharp/src/PdfSharp.BarCodes/PdfSharp.BarCodes.csproj",
            "PDFsharp/src/PdfSharp.Charting/PdfSharp.Charting.csproj",
            "PDFsharp/src/PdfSharp.Cryptography/PdfSharp.Cryptography.csproj",
            "MigraDoc/src/MigraDoc.DocumentObjectModel/MigraDoc.DocumentObjectModel.csproj",
            "MigraDoc/src/MigraDoc.Rendering/MigraDoc.Rendering.csproj",
            "MigraDoc/src/MigraDoc.RtfRendering/MigraDoc.RtfRendering.csproj"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "properties": { "TargetFramework": "net10.0", "Configuration": "Release" },
      "memberLayout": "separatePages",
      "namespaceLayout": "nested"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md", "reference.md", "toc.yml",
          "guide/*.md", "guide/toc.yml",
          "api/**.yml",
          "text-extraction.md", "accessibility-preflight.md", "migrating-to-7.md", "support-policy.md"
        ]
      }
    ],
    "resource": [
      { "files": [ "images/freepdf.svg" ] }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appTitle": "FreePDF",
      "_appName": "FreePDF",
      "_appLogoPath": "images/freepdf.svg",
      "_appFaviconPath": "images/freepdf.svg",
      "_appFooter": "FreePDF is MIT licensed. Source: https://github.com/io7/FreePDF",
      "_enableSearch": true,
      "_disableContribution": true
    },
    "sitemap": { "baseUrl": "https://io7.github.io/FreePDF/" }
  }
}
