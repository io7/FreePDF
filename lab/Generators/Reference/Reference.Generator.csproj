<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net462</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Deliberately pinned to the final MIT preview. Updating the oracle is a reviewed change. -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="[7.0.0-preview-1]" />
    <PackageReference Include="System.Text.Json" Version="10.0.5" />
    <Compile Include="../../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../Assets/DejaVuSans.ttf" LogicalName="LabFont.ttf" />
    <EmbeddedResource Include="../../Assets/colors.png" LogicalName="LabImage.png" />
  </ItemGroup>
</Project>
